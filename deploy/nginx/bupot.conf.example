# Copy to the Nginx sites-enabled directory and replace the certificate paths.
# The application container must publish 127.0.0.1:3000 only.

upstream bupot_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    server_name bupot.menpan.go.id;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name bupot.menpan.go.id;

    ssl_certificate /etc/letsencrypt/live/bupot.menpan.go.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bupot.menpan.go.id/privkey.pem;

    client_max_body_size 20m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    location / {
        proxy_pass http://bupot_app;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location = /api/health/ready {
        proxy_pass http://bupot_app;
        access_log off;
    }
}
