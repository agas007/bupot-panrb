// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

model Colleague {
  id                      Int                       @id @default(autoincrement())
  username                String                    @unique
  password                String
  name                    String                    @unique
  role                    String                    @default("USER") // ADMIN or USER
  records                 SPMRecord[]
  notifications           Notification[]
  reconciliationPeriods   TaxReconciliationPeriod[] @relation("ReconciliationCreatedBy")
  pph21Exports            Pph21Export[]             @relation("Pph21ExportedBy")
  archivedRecords         ArchivedRecord[]          @relation("ArchivedBy")
  archiveAccessLogs       ArchiveAccessLog[]        @relation("AccessedBy")
  disposalRequestsCreated DisposalApproval[]        @relation("RequestedBy")
  disposalApprovalsGiven  DisposalApproval[]        @relation("ApprovedBy")
  archiveDossiersCreated  ArchiveDossier[]          @relation("ArchiveDossierCreatedBy")
  archiveDossierAttachmentsUploaded ArchiveDossierAttachment[] @relation("ArchiveDossierAttachmentUploadedBy")
  createdAt               DateTime                  @default(now())
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      Colleague @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String // INFO, WARNING, SUCCESS, DANGER
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
}

model SPMRecord {
  id              Int      @id @default(autoincrement())
  // Identification (from Excel merging)
  uniqueKey       String   @unique // Combination of spmNumber + accountCode + deductionAmount
  spmNumber       String
  spmDate         DateTime
  accountCode     String
  deductionAmount Float

  // Details (from the two source excels)
  sp2dNumber  String?
  sp2dDate    DateTime?
  description String?
  recipient   String?
  totalValue  Float?

  // Tracking
  status         String     @default("PENDING") // PENDING, COMPLETED
  assigneeId     Int?
  assignee       Colleague? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  completionDate DateTime?
  docLink        String?
  notes          String?

  // Metadata
  importDate DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  pph21Batch Pph21Batch?

  // Archive tracking
  archiveStatus  String     @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED, DISPOSED
  archivedRecord ArchivedRecord?

  @@index([accountCode, sp2dDate])
  @@index([sp2dNumber])
  @@index([status])
  @@index([assigneeId])
  @@index([archiveStatus])
}

model Pph21Recipient {
  id                   Int                @id @default(autoincrement())
  nik                  String             @unique
  name                 String
  defaultTaxObjectCode String
  withholdings         Pph21Withholding[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([name])
}

model Pph21RecipientPtkp {
  id          Int      @id @default(autoincrement())
  nik         String
  name        String
  taxYear     Int
  statusPtkp  String
  category    String?
  sourceData  String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([nik, taxYear])
  @@index([nik])
  @@index([taxYear])
  @@index([statusPtkp])
}

model Pph21Batch {
  id              Int                @id @default(autoincrement())
  recordId        Int                @unique
  record          SPMRecord          @relation(fields: [recordId], references: [id], onDelete: Cascade)
  withholdingDate DateTime?
  status          String             @default("PENDING")
  issueNotes      String?
  withholdings    Pph21Withholding[]
  exportItems     Pph21ExportItem[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
}

model Pph21Withholding {
  id            Int            @id @default(autoincrement())
  batchId       Int
  batch         Pph21Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  recipientId   Int
  recipient     Pph21Recipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  recipientName String
  taxObjectCode String
  gross         Float
  deemed        Float
  rate          Float
  calculatedTax Float
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([batchId])
  @@index([recipientId])
}

model Pph21Export {
  id           Int               @id @default(autoincrement())
  fileName     String
  exportedById Int?
  exportedBy   Colleague?        @relation("Pph21ExportedBy", fields: [exportedById], references: [id], onDelete: SetNull)
  items        Pph21ExportItem[]
  createdAt    DateTime          @default(now())
}

model Pph21ExportItem {
  id       Int         @id @default(autoincrement())
  exportId Int
  export   Pph21Export @relation(fields: [exportId], references: [id], onDelete: Cascade)
  batchId  Int
  batch    Pph21Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([exportId, batchId])
  @@index([batchId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userName  String
  username  String
  action    String
  target    String
  category  String   @default("GENERAL") // AUTH, DATA, ADMIN, SECURITY, GENERAL
  type      String // info, success, warning, danger
  createdAt DateTime @default(now())
}

model TaxReconciliationPeriod {
  id          Int                       @id @default(autoincrement())
  year        Int
  month       Int
  title       String?
  notes       String?
  status      String                    @default("DRAFT")
  createdById Int?
  createdBy   Colleague?                @relation("ReconciliationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  targets     TaxReconciliationTarget[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@unique([year, month])
  @@index([year, month])
}

model TaxReconciliationTarget {
  id            Int                     @id @default(autoincrement())
  periodId      Int
  period        TaxReconciliationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  accountCode   String
  coretaxAmount Float
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([periodId, accountCode])
  @@index([accountCode])
}

model ArchivePolicy {
  id               Int    @id @default(autoincrement())
  dataType         String @unique // SPM_RECORD, PPH21_WITHHOLDING, TAX_RECONCILIATION
  retentionYears   Int // 5, 5, 3 respectively
  inactivePeriod   Int // years before becoming inactive (1)
  disposalMethod   String @default("SOFT_DELETE") // SOFT_DELETE, PERMANENT_DELETE
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([dataType])
}

model ArchivedRecord {
  id              Int    @id @default(autoincrement())
  originalId      Int    // reference ke original record id
  dataType        String // SPM_RECORD, PPH21_WITHHOLDING, TAX_RECONCILIATION
  archivedData    Json   // snapshot of data sebagai JSON
  archivedById    Int?
  archivedBy      Colleague? @relation("ArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  spmNumber       String? // for SPM records, extract untuk easy searching
  spmRecordId     Int? @unique
  spmRecord       SPMRecord? @relation(fields: [spmRecordId], references: [id], onDelete: Cascade)

  accessLogs      ArchiveAccessLog[]
  disposalApproval DisposalApproval?

  archiveStatus   String @default("ARCHIVED") // ARCHIVED, ELIGIBLE_FOR_DISPOSAL, DISPOSED
  disposalScheduledDate DateTime?
  disposalScheduledAt DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([dataType])
  @@index([spmNumber])
  @@index([archiveStatus])
  @@index([originalId])
  @@unique([originalId, dataType])
}

model ArchiveAccessLog {
  id              Int    @id @default(autoincrement())
  archivedRecordId Int
  archivedRecord  ArchivedRecord @relation(fields: [archivedRecordId], references: [id], onDelete: Cascade)

  accessedById    Int
  accessedBy      Colleague @relation("AccessedBy", fields: [accessedById], references: [id], onDelete: Cascade)

  accessType      String // VIEW, EXPORT, VERIFY, RESTORE
  reason          String?
  ipAddress       String?

  createdAt       DateTime @default(now())

  @@index([archivedRecordId])
  @@index([accessedById])
  @@index([createdAt])
}

model DisposalApproval {
  id              Int    @id @default(autoincrement())
  archivedRecordId Int @unique
  archivedRecord  ArchivedRecord @relation(fields: [archivedRecordId], references: [id], onDelete: Cascade)

  requestedById   Int
  requestedBy     Colleague @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)

  approvedById    Int?
  approvedBy      Colleague? @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  status          String @default("PENDING") // PENDING, APPROVED, REJECTED, DISPOSED
  disposalMethod  String @default("SOFT_DELETE") // SOFT_DELETE, PERMANENT_DELETE

  approvalDate    DateTime?
  disposalExecutedAt DateTime?
  reason          String?
  rejectionReason String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([archivedRecordId])
  @@index([createdAt])
}

model ArchiveDossier {
  id             Int      @id @default(autoincrement())
  dossierIndex   String   @unique
  title          String
  period         String?
  notes          String?
  status         String   @default("STORED") // STORED, NEEDS_REVIEW, CLOSED
  createdById    Int?
  createdBy      Colleague? @relation("ArchiveDossierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  attachments    ArchiveDossierAttachment[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([dossierIndex])
  @@index([status])
  @@index([createdAt])
}

model ArchiveDossierAttachment {
  id             Int      @id @default(autoincrement())
  dossierId      Int
  dossier        ArchiveDossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  fileName       String
  mimeType       String
  size           Int
  fileData       Bytes
  uploadedById   Int?
  uploadedBy     Colleague? @relation("ArchiveDossierAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt      DateTime @default(now())

  @@index([dossierId])
  @@index([createdAt])
}
