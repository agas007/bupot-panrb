NODE_ENV=production
TZ=Asia/Jakarta

# Database Configuration
DATABASE_URL=postgresql://bupot_user:bupot_password@postgres:5432/bupot_db?schema=public
DIRECT_URL=postgresql://bupot_user:bupot_password@postgres:5432/bupot_db?schema=public

# MinIO / Object Storage Configuration
S3_ENDPOINT=https://minio.domainkamu.go.id
S3_REGION=us-east-1
